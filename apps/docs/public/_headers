# Pages stay revalidated on every visit so a deploy shows up at once. No rule
# here carries `no-transform`: with it Cloudflare skips compression, and the
# only thing it bought was keeping the zone's bot protection script out of the
# HTML. That script is accepted, and the privacy page names its cookie.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Build assets carry a content hash in their file name, so a changed file is
# always a new URL and the old one can be cached for good.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
