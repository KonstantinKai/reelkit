# Pages must reach the reader exactly as built. `no-transform` stops the
# Cloudflare zone from injecting its JavaScript detections script into every
# HTML page, which the Free plan offers no switch for. Pages stay revalidated
# on every visit so a deploy shows up at once.
/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# Build assets carry a content hash in their file name, so a changed file is
# always a new URL and the old one can be cached for good.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform
