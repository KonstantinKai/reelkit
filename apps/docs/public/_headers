# Pages stay revalidated on every visit so a deploy shows up at once.
#
# No `no-transform` here: Cloudflare skips compression for any response that
# carries it, which left every page, stylesheet and script uncompressed. It was
# only ever there to keep the JavaScript detections script out of the pages,
# and that script comes with Bot Fight Mode, which is off for this zone. The
# docs probe fails the deploy if the script ever shows up in a page again.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Build assets carry a content hash in their file name, so a changed file is
# always a new URL and the old one can be cached for good.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
