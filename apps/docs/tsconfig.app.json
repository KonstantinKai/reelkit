{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "../dist/out-tsc",
    "types": [
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts",
      "vite/client"
    ]
  },
  "exclude": [
    // Code samples sit one folder deep and are often fragments. A recipe's
    // React code and data sit two deep, because its demo runs them; its
    // Vue and Angular versions go to tsconfig.recipes.json instead.
    "src/content/snippets/*/*.*",
    "src/content/snippets/recipes/**/angular.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.test.js",
    "src/**/*.spec.jsx",
    "src/**/*.test.jsx",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../../packages/reelkit-angular-stories-player/tsconfig.lib.json"
    },
    {
      "path": "../../packages/reelkit-vue-stories-player/tsconfig.lib.json"
    },
    {
      "path": "../../packages/reelkit-vue-reel-player/tsconfig.lib.json"
    },
    {
      "path": "../../packages/reelkit-vue-lightbox/tsconfig.lib.json"
    },
    {
      "path": "../../packages/reelkit-vue/tsconfig.lib.json"
    },
    {
      "path": "../../packages/reelkit-stories-core/tsconfig.lib.json"
    },
    {
      "path": "../../packages/reelkit-react-stories-player/tsconfig.lib.json"
    },
    {
      "path": "../../packages/reelkit-react-reel-player/tsconfig.lib.json"
    },
    {
      "path": "../../packages/reelkit-react-lightbox/tsconfig.lib.json"
    },
    {
      "path": "../../packages/reelkit-react/tsconfig.lib.json"
    },
    {
      "path": "../../packages/reelkit-example-data/tsconfig.lib.json"
    },
    {
      "path": "../../packages/reelkit-core/tsconfig.lib.json"
    },
    {
      "path": "../../packages/reelkit-angular-reel-player/tsconfig.lib.json"
    },
    {
      "path": "../../packages/reelkit-angular-lightbox/tsconfig.lib.json"
    },
    {
      "path": "../../packages/reelkit-angular/tsconfig.lib.json"
    }
  ]
}
