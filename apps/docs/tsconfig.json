{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/content/snippets"],
  "references": [
    {
      "path": "../../packages/reelkit-react-reel-player"
    },
    {
      "path": "../../packages/reelkit-react-lightbox"
    },
    {
      "path": "../../packages/reelkit-react"
    },
    {
      "path": "../../packages/reelkit-angular-reel-player"
    },
    {
      "path": "../../packages/reelkit-angular-lightbox"
    },
    {
      "path": "../../packages/reelkit-angular"
    },
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
