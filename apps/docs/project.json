{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/docs/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project docs --web",
  "targets": {
    "test": {
      "inputs": [
        "default",
        "^production",
        {
          "fileset": "{projectRoot}/tsconfig.spec.json",
          "dependencies": true
        },
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": ["compilerOptions"]
        },
        { "externalDependencies": ["vitest"] },
        { "env": "CI" },
        { "dependentTasksOutputFiles": "**/*.js", "transitive": true },
        "{workspaceRoot}/scripts/**/*",
        "{workspaceRoot}/apps/example-react/index.html",
        "{workspaceRoot}/apps/example-react/vite.config.ts",
        "{workspaceRoot}/apps/example-vue/index.html",
        "{workspaceRoot}/apps/example-vue/vite.config.mts",
        "{workspaceRoot}/apps/example-angular/project.json",
        "{workspaceRoot}/apps/example-angular/src/index*.html"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/docs",
        "command": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && vue-tsc --noEmit -p tsconfig.recipes.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "commands": [
          "npx react-router build",
          "rm -rf ../dist/docs && mkdir -p ../dist/docs && cp -R build/client/. ../dist/docs/",
          "cp ../dist/docs/__spa-fallback.html ../dist/docs/404.html",
          "rm -rf build"
        ],
        "cwd": "apps/docs",
        "parallel": false
      },
      "outputs": ["{workspaceRoot}/apps/dist/docs"],
      "cache": true
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx react-router dev",
        "cwd": "apps/docs"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npx serve ../dist/docs -l 4200",
        "cwd": "apps/docs"
      }
    }
  }
}
