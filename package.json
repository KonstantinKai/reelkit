  "name": "@reelkit/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm exec nx run-many -t build --no-tui",
    "fmt:chk": "pnpm exec nx format:check",
    "fmt": "pnpm exec nx format",
    "lint": "pnpm exec nx run-many -t lint --no-tui",
    "typecheck": "pnpm exec nx run-many -t typecheck --no-tui",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:i18n": "node scripts/docs-i18n.mjs",
    "check": "pnpm run fmt:chk && pnpm run lint && pnpm run typecheck && pnpm run docs:check",
    "test": "pnpm exec nx run-many -t test --no-tui",
    "e2e": "pnpm exec nx run-many -t e2e --no-tui",
    "update-sizes": "node scripts/update-sizes.mjs",
    "release:npm": "which op > /dev/null 2>&1 && op run --env-file=.env.op -- sh -c 'env \"pnpm_config_//registry.npmjs.org/:_authToken=$NPM_TOKEN\" pnpm exec nx release publish' || echo '1Password CLI (op) is not installed. Install it from https://1password.com/downloads/command-line/'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KonstantinKai/reelkit.git"
  },
  "bugs": "https://github.com/KonstantinKai/reelkit/issues",
  "homepage": "https://reelkit.dev",
  "private": true,
