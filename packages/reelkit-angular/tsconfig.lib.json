{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": []
  },
  "include": ["src/**/*.ts", "ng-router-url-adapter/src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "ng-router-url-adapter/src/**/*.spec.ts",
    "jest.config.ts",
    "jest.config.cts",
    "src/test-setup.ts"
  ],
  "references": [
    {
      "path": "../reelkit-core/tsconfig.lib.json"
    }
  ]
}
