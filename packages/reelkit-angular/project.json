{
  "name": "@reelkit/angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/reelkit-angular/src",
  "prefix": "rk",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["{projectRoot}", "dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": ["scope:angular", "type:bindings"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "defaultConfiguration": "production",
      "options": {
        "project": "packages/reelkit-angular/ng-package.json",
        "tsConfig": "packages/reelkit-angular/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "packages/reelkit-angular/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "prepare-publish": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node scripts/resolve-workspace-protocol.mjs dist/{projectRoot}/package.json"
      }
    },
    "nx-release-publish": {
      "dependsOn": ["prepare-publish"],
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "typecheck-spec": {
      "command": "tsc --noEmit -p tsconfig.spec.json",
      "options": {
        "cwd": "{projectRoot}"
      }
    }
  }
}
