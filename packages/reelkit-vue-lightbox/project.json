{
  "name": "@reelkit/vue-lightbox",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/reelkit-vue-lightbox/src",
  "projectType": "library",
  "tags": ["scope:vue", "type:lightbox"],
  "targets": {
    "typecheck-spec": {
      "command": "vue-tsc -b tsconfig.spec.json --emitDeclarationOnly",
      "options": { "cwd": "{projectRoot}" }
    }
  },
  "release": {
    "version": {
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  }
}
